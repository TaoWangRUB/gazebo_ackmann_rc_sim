<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <!-- Use specific interfaces (add others like eth0 if needed) -->
      <Interfaces>
        <NetworkInterface address="127.0.0.1"/>
        <!-- You can add a real interface like:
        <NetworkInterface name="eth0"/>
        -->
      </Interfaces>

      <!-- Enable multicast for auto discovery -->
      <AllowMulticast>true</AllowMulticast>
    </General>

    <!-- Enable native CycloneDDS shared memory transport -->
    <SharedMemory>
      <Enable>false</Enable>
    </SharedMemory>

    <!-- Peer discovery settings -->
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <!-- Optional peers; not needed if multicast works -->
      <!-- <Peers><Peer address="127.0.0.1"/></Peers> -->
    </Discovery>

    <!-- Tracing for debugging DDS behavior -->
    <Tracing>
      <Verbosity>finest</Verbosity>
      <OutputFile>/tmp/cyclonedds_trace.log</OutputFile>
    </Tracing>
  </Domain>
</CycloneDDS>
